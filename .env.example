# Naam en adres van de site
NEXT_PUBLIC_SITE_NAME=Dealvanger
NEXT_PUBLIC_SITE_URL=https://jouw-site.vercel.app

# Lange willekeurige tekst (min. 32 tekens) om login-cookies te ondertekenen
SESSION_SECRET=

# Geheime sleutel waarmee cron-job.org de scan mag starten
CRON_SECRET=

# Turso database (leeg laten = lokaal bestand local.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# E-mail via SMTP (leeg laten = mails worden in de terminal getoond)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=jij@gmail.com, SMTP_PASS=<app-wachtwoord>
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=<api-key>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# AI-controle op foto + tekst (optioneel). Sleutel van https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model voor de AI-controle (standaard claude-haiku-5-5, goedkoop; claude-opus-5-5 is nauwkeuriger maar ~40x duurder)
AI_MODEL=

# Maximaal aantal filters per gebruiker
MAX_FILTERS_PER_USER=5

# Eigenaar(s) van de site (e-mailadressen, met komma gescheiden) mogen meer filters hebben
OWNER_EMAILS=
OWNER_MAX_FILTERS=25

# Optioneel: code uit Google Search Console (HTML-tag methode)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
